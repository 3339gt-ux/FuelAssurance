# Fuel Assurance — Environment Variables
# Copy to .env.local for local development. NEVER commit .env.local.

# Supabase (optional — local JSON DB used by default in Simple Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=fuel-assurance-uploads

# Application
NEXT_PUBLIC_APP_NAME=Fuel Assurance
NEXT_PUBLIC_APP_URL=http://localhost:3993

# Processing
MAX_UPLOAD_SIZE_MB=100
PDF_OCR_CONFIDENCE_THRESHOLD=0.75
DEFAULT_QUANTITY_TOLERANCE=0.02

# E2E / dev test hooks (Playwright upload reliability)
NEXT_PUBLIC_E2E_HOOKS=false