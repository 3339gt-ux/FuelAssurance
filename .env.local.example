# Fuel Assurance — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# File storage
SUPABASE_STORAGE_BUCKET=fuel-assurance-uploads

# Application
NEXT_PUBLIC_APP_NAME=Fuel Assurance
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Processing
MAX_UPLOAD_SIZE_MB=100
PDF_OCR_CONFIDENCE_THRESHOLD=0.75
DEFAULT_QUANTITY_TOLERANCE=0.02
